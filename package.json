{
  "name": "contextqa-ci",
  "private": true,
  "description": "Run ContextQA test plans from CI pipelines",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/github-action",
    "packages/azure-devops-task"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/cli packages/github-action packages/azure-devops-task",
    "bundle": "node scripts/bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "check": "npm run build && npm run typecheck && npm test",
    "bundle:cli": "node scripts/bundle-cli.mjs",
    "bundle:azure": "node scripts/bundle-azure-task.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "esbuild": "^0.28.2"
  }
}
